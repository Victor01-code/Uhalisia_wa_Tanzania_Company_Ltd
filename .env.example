APP_NAME="Uhalisia wa Tanzania"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Africa/Dar_es_Salaam"
APP_URL=https://portal.uhalisiawatanzania.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uhalisia_portal
DB_USERNAME=cpanel_dbuser
DB_PASSWORD=cpanel_dbpass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail.uhalisiawatanzania.com
MAIL_PORT=465
MAIL_USERNAME=info@uhalisiawatanzania.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@uhalisiawatanzania.com"
MAIL_FROM_NAME="Uhalisia wa Tanzania Safaris and Tours"

# Company Contact Details
COMPANY_NAME="Uhalisia wa Tanzania Company Ltd"
COMPANY_TAGLINE="Safaris and Tours"
COMPANY_EMAIL="info@uhalisiawatanzania.com"
COMPANY_PHONE="+255 784 590 722"
COMPANY_WEBSITE="www.uhalisiawatanzania.com"
COMPANY_OFFICES="Arusha & Dar es Salaam, Tanzania"

# Security Tokens
INQUIRY_API_TOKEN=generate_random_token_here
